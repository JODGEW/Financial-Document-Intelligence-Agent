.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
chroma_db/
# Review queue JSONL files are mutable runtime state (like audit_logs/): a
# clean clone starts with an empty queue. The directory itself is kept via
# review_queue/.gitkeep; seed local demo data with
# `python scripts/review_queue.py seed`.
review_queue/*.jsonl
# Filing registry JSONL is mutable runtime state written by `python ingest.py`
# (per-source ingestion outcomes + filing identities). A clean clone starts
# empty; the directory is kept via filing_registry/.gitkeep.
filing_registry/*.jsonl
# Comparison entity store (SQLite + sidecar wal/journal files) is runtime
# state written by the comparison API; the directory is kept via
# comparisons/.gitkeep.
comparisons/*.db*
.DS_Store
WALKTHROUGH.md
.gradio/
audit_logs/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js
CLAUDE.md

# Local-only dev notes (kept out of the public repo)
GOVERNANCE_PROGRESS.md
MULTI_FORMAT_PROGRESS.md
EVAL_PROGRESS.md
Governance_layer.md
GOVERNANCE_PHASES_1-5_SUMMARY.md
docs-internal/

assets/docs/

# Local single-node reference runtime: the filled-in env file holds a real
# secret, and the state directory holds the runtime SQLite database, filing
# registry, and vector store. Only .env.reference.example is committed.
.env.reference
reference-state/
