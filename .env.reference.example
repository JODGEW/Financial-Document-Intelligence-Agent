# Local single-node reference runtime — template only. Copy to .env.reference
# and fill in values. NEVER commit the filled-in file, and never put a real
# secret in this template.
#
# This is a local reference runtime for evaluating the comparison workflow on
# one machine. It is NOT a production deployment: there is no scheduler, no
# daemon, no job-processing loop, no external queue, no multi-node
# coordination, and no high-availability or exactly-once guarantee. The worker
# is a manually invoked one-shot process.
#
#   scripts/run_reference_api.sh      one long-running API process
#   scripts/run_reference_worker.sh   one manually invoked one-shot worker
#
# Both scripts read this file, so both processes point at the SAME persistent
# state. Initialization and readiness are separate: see OPERATIONS.md.

# --- Persistent state ---------------------------------------------------------
# One directory holding every durable artifact the workflow needs. Back this up
# deliberately; see the workflow-database backup runbook in OPERATIONS.md for
# what a SQLite-only backup does and does not cover.
FDIA_STATE_DIR=./reference-state

# Derived from FDIA_STATE_DIR by the run scripts. Override only if you need the
# three artifacts in different places.
# COMPARISON_DB_PATH=./reference-state/comparisons/comparisons.db
# FILING_REGISTRY_PATH=./reference-state/filing_registry/registry.jsonl
# CHROMA_PERSIST_DIR=./reference-state/chroma_db

# --- API binding --------------------------------------------------------------
FDIA_API_HOST=127.0.0.1
FDIA_API_PORT=8000

# --- Runtime secret -----------------------------------------------------------
# REQUIRED by the API process; the worker is credential-free and never reads it.
# Supply it externally — leave it unset here so a filled-in copy of this file is
# not the thing holding your secret. At least 32 UTF-8 bytes. Generate it
# without placing it in shell history:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotation invalidates every outstanding token. See the auth-secret rotation
# runbook in OPERATIONS.md.
# FDIA_AUTH_SECRET=

# --- AWS Bedrock --------------------------------------------------------------
# Needed only by the generic chat/RAG surface. The comparison detection
# workflow — enqueue, claim, detect, finalize — is fully deterministic and
# reaches no model provider, so the reference runtime can exercise it with
# these unset.
AWS_REGION=us-east-1
# AWS credentials resolve through the standard boto3 chain.
